#!/usr/bin/env bash
# Mobile Control Runner - Main entry point for OpenCode

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADB_SCRIPT="$SCRIPT_DIR/scripts/adb/interact.sh"
DEVICE_SCRIPT="$SCRIPT_DIR/scripts/adb/device.sh"
SCRCPY_SCRIPT="$SCRIPT_DIR/scripts/scrcpy/launch.sh"

# Check dependencies upfront
check_deps() {
  local missing=()
  command -v adb >/dev/null 2>&1 || missing+=("adb (android-platform-tools)")
  command -v scrcpy >/dev/null 2>&1 || missing+=("scrcpy")
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing dependencies: ${missing[*]}" >&2
    echo "Run ./setup.sh to install" >&2
    exit 1
  fi
}

# Export serial for all scripts (respects existing ANDROID_SERIAL)
export ANDROID_SERIAL="${ANDROID_SERIAL:-$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1; exit}')}"
[[ -z "$ANDROID_SERIAL" ]] && echo "Warning: No device detected. Connect device with USB debugging enabled." >&2

usage() {
  cat <<EOF
Mobile Control - Visible Android automation from OpenCode

Usage: $0 <command> [args...]

Device:
  device serial           Get device serial
  device model            Get device model
  device version          Get Android version
  device sdk              Get SDK version
  device resolution       Get screen resolution
  device density          Get screen density
  device list             List all devices

Screen (scrcpy):
  view                    Start scrcpy mirroring
  view --no-audio         Mirror without audio
  view --record file.mp4  Mirror and record
  view --fullscreen       Fullscreen mode

Interaction:
  tap <x> <y>             Tap coordinates
  swipe <x1> <y1> <x2> <y2> [ms]  Swipe (default 500ms)
  input <text>            Type text
  back                    Back button
  home                    Home button
  recent                  Recent apps
  menu                    Menu button
  power                   Power button
  volup                   Volume up
  voldown                 Volume down
  enter                   Enter key
  key <keycode>           Send keycode

Screen capture:
  screenshot [path]       Take screenshot (default /tmp/screenshot-TIME.png)
  record-start [path] [sec]  Start recording (default 180s, returns PID file)
  record-stop <pid_file> [remote] [local]  Stop & pull recording

UI inspection:
  hierarchy               Dump UI hierarchy
  find-text <text>        Find elements containing text
  find-id <id>            Find element by resource-id
  tap-text <text>         Find by text AND tap center
  tap-id <id>             Find by id AND tap center

Apps:
  launch <package> [activity]  Launch app
  kill <package>            Force stop app
  clear <package>           Clear app data
  packages [filter]         List packages
  activity                  Get current foreground activity

Examples:
  $0 view                           # Start mirroring
  $0 launch com.instagram.android   # Open Instagram
  $0 tap-text "Login"               # Tap button by text
  $0 swipe 540 1800 540 600         # Swipe up
  $0 screenshot /tmp/app.png        # Save screenshot
  $0 find-text "Continue"           # Find elements

Environment:
  ANDROID_SERIAL    Device serial (auto-detected if not set)
EOF
}

# Check dependencies first
check_deps

# Dispatch
case "${1:-}" in
  ""|--help|-h) usage ;;
  device) "$DEVICE_SCRIPT" "${2:-}" "${3:-}" ;;
  view) shift; "$SCRCPY_SCRIPT" "$@" ;;
  tap|swipe|input|key|back|home|recent|menu|power|volup|voldown|enter|screenshot|record-start|record-stop|hierarchy|find-text|find-id|tap-text|tap-id|launch|kill|clear|packages|activity)
    "$ADB_SCRIPT" "$@"
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage
    exit 1
    ;;
esac